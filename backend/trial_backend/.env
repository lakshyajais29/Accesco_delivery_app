# ── .env  (copy to project root, never commit) ────────────────────────────────
# Database
DATABASE_URL = "sqlite+aiosqlite:///./trial.db"
# Redis
REDIS_URL=redis://localhost:6379/0

# Firebase Cloud Messaging (FCM v1 — service-account JSON path)
GOOGLE_APPLICATION_CREDENTIALS=/secrets/accesco-firebase-adminsdk.json
FCM_PROJECT_ID=accesco-living

# Rider Service (internal microservice or mock URL during dev)
RIDER_SERVICE_URL=http://localhost:8001

# Trial config
TRIAL_DURATION_SECONDS=900        # 15 minutes
TRIAL_SESSION_TTL_SECONDS=3600    # Redis key TTL (1 hr safety margin)

# Shared secret for the X-API-Key header the Flutter app sends.
# Must match the PAYMENTS_API_KEY / TRIAL_API_KEY dart-define in the app.
INTERNAL_API_KEY=dev-key-change-me

# Razorpay. The secret never leaves this process: it fixes the order amount
# in POST /api/v1/payments/orders and verifies the checkout signature in
# POST /api/v1/payments/verify. Leave both blank in local dev and the service
# returns a dev order and accepts any signature, with a warning in the log.
RAZORPAY_KEY_ID=rzp_test_XXXX
RAZORPAY_KEY_SECRET=XXXX
